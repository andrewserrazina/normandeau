# Copy this file to .env.local for local development. In production
# (Cloudflare Pages), set these as build-time environment variables —
# see README.md for details on each.

# TinaCMS (see "Editing Content with TinaCMS" in README.md)
NEXT_PUBLIC_TINA_CLIENT_ID=
TINA_TOKEN=

# Consultation form backend (see "Connecting the Contact Form" in README.md)
# Formspree endpoint, e.g. https://formspree.io/f/xxxxxxxx
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
