{
  "name": "normandeau",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tinacms build && next build",
    "dev": "tinacms dev -c \"next dev\"",
    "start": "next start",
    "lint": "eslint",
    "preview": "tinacms build && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "tinacms build && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "tinacms build && opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tinacms": "^3.11.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tinacms/cli": "^2.5.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.113.0"
  }
}
